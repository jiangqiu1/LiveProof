# LiveProof / POLYV 凭证配置
# 用法：把 AppSecret 粘贴到等号后面，不要加引号、不要留空格。
# 这个文件只在本地使用，不会被提交，也不会被打印到聊天里。

# ---------- 云直播（已确认可用） ----------
POLYV_LIVE_APP_ID=
POLYV_LIVE_APP_SECRET=
POLYV_LIVE_USER_ID=
POLYV_LIVE_CHANNEL_ID=

# ---------- 云点播（当前账号未开通，先留空） ----------
POLYV_VOD_USER_ID=
POLYV_VOD_SECRET_KEY=

# ---------- 演示素材（智能剪辑里的真实视频） ----------
POLYV_DEMO_VID=
POLYV_DEMO_VID_DURATION=
POLYV_WATCH_URL=

# LiveProof Web（本机 MySQL 实例）
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=liveproof
MYSQL_USER=
MYSQL_PASSWORD=

# ---------- AI 辅助核验（可选，留空时 AI 功能返回"未配置"而不是模拟结果） ----------
# 只被后端读取；不要加 VITE_ 前缀，不要写进前端代码。
# 端点必须是 OpenAI 兼容协议（后端会自行拼接 /chat/completions）。
# 官方 DeepSeek：https://api.deepseek.com
# 阿里云百炼：https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 模型调用超时与重试（毫秒 / 次数）
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=1
# 模型输出上限。推理模型的思维链同样计入该额度，2048 在完整核验提示词下可能被
# 思维链耗尽导致正文为空（finish_reason=length），故默认给足。
AI_MAX_TOKENS=8192
# 单次分析提交的关键帧数量与宽度上限
AI_MAX_FRAMES=4
AI_FRAME_MAX_WIDTH=720

# ---------- 关键帧提取（可选） ----------
# FFmpeg 不在 PATH 时填绝对路径，例如 Windows 上的 ffmpeg.exe
LIVEPROOF_FFMPEG_PATH=
